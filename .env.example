# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=thinkingmachines/inkling:free
# Optional, only affect your ranking on openrouter.ai/rankings — safe to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Backseat
# Safety cap on simultaneous requests to OpenRouter.
OPENROUTER_MAX_CONCURRENCY=2

# Persona/behavior prompt. Loaded from BOT_PROMPT_FILE if that file exists;
# BOT_PROMPT below is only a fallback if the file is missing.
BOT_PROMPT_FILE=prompt.txt
BOT_PROMPT=Комментируй сообщения участников с максимальным сарказмом.

# --- Batching / debounce ---
# The bot buffers incoming messages per chat and asks the LLM once per BATCH,
# not once per message. A batch closes when either:
#  - DEBOUNCE_SECONDS of silence pass since the last message in it, or
#  - MAX_BATCH_WAIT_SECONDS pass since the first message in it, or
#  - it reaches MAX_BATCH_MESSAGES.
DEBOUNCE_SECONDS=5
# Shorter debounce used once the batch contains a mention/reply-to-bot message.
MENTION_DEBOUNCE_SECONDS=2
MAX_BATCH_WAIT_SECONDS=15
MAX_BATCH_MESSAGES=15

# How many past (already-processed) messages to keep as CONTEXT per chat
CONTEXT_WINDOW=25
# Per-message character caps used when serializing for the model
MAX_CONTEXT_MESSAGE_CHARS=500
MAX_NEW_MESSAGE_CHARS=1000
# Extra cap on CONTEXT sent to the model, in a rough token estimate
# (oldest messages are dropped first if it doesn't fit)
MAX_INPUT_TOKENS=1500

# Cooldown: minimum seconds between two comments Backseat actually sends in a
# chat, counted from the last comment actually sent (not from decisions).
MIN_SECONDS_BETWEEN_COMMENTS=25
# If a batch contains a mention/reply-to-bot, should it bypass the cooldown?
MENTION_BYPASSES_COOLDOWN=true

# --- Model call tuning ---
# Output token budget: just the decision JSON + a short comment.
# Output token budget: decision JSON + a short comment. Reasoning models can
# burn part of this on internal thinking before writing content, so keep
# headroom (raise further if logs show "empty content" warnings).
MAX_TOKENS=300
REQUEST_TIMEOUT_SECONDS=30
