# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Models in priority order: the first one that answers wins. Paid models need credits
# (https://openrouter.ai/settings/credits). ":free" models are limited to 50 requests a day,
# 1000 a day once $10+ of credits were ever bought.
MODELS=deepseek/deepseek-v4.1-flash,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
# Hidden model reasoning: off | low | medium | high. Chat replies don't need it.
REASONING=off
# OpenRouter hosts to try first; the others stay as a fallback. Left to itself, OpenRouter may pick
# a host several times pricier than the cheapest one for the same model (see the model's Providers tab).
# Pick one that also discounts cached input: the prompt is built so consecutive calls share a long prefix.
PROVIDERS=InferenceNet,Relace,Wafer
MAX_TOKENS=1000
REQUEST_TIMEOUT_SECONDS=60

# Who may change the persona and names (/prompt, /names). Send /id to the bot to learn yours.
OWNER_IDS=
# Chats the bot works in (send /id in the group to see its id). Empty = any chat.
ALLOWED_CHAT_IDS=
# Names the bot answers to without @, comma-separated. Change them live with /names.
BOT_NAMES=бэксит,ботяра
# Participants with a fixed display name and a longer personal history: id:name,id:name
FOCUS_USERS=123456789:Иван

# Default persona; the owner overrides it with /prompt (in private) or in the web panel.
PERSONA_FILE=prompts/persona.md
DB_PATH=data/backseat.db
TIMEZONE=Europe/Moscow

# A batch of messages is processed after DEBOUNCE_SECONDS of silence
# (ADDRESSED_DEBOUNCE_SECONDS when the bot was called), after MAX_BATCH_WAIT_SECONDS at most,
# or right away at MAX_BATCH_MESSAGES.
DEBOUNCE_SECONDS=5
ADDRESSED_DEBOUNCE_SECONDS=1.5
MAX_BATCH_WAIT_SECONDS=20
MAX_BATCH_MESSAGES=15
# Minimum pause between two comments nobody asked for. Answers to direct calls ignore it.
UNPROMPTED_COOLDOWN_SECONDS=60
# After the bot answers someone, that person waits this long: calling it meanwhile gets
# "Ещё не готов ответить" (once) instead of a paid answer. Everyone has their own timer. 0 = off.
REPLY_FREEZE_SECONDS=30
# Busy chats: before deciding on a comment nobody asked for, show the model only this many tokens of
# the latest chat and ask yes/no; the full prompt with the memory is paid for only on "yes".
# 0 = always the full prompt (fine for a quiet chat), 600 ~ the last 30 messages.
PRECHECK_CONTEXT_TOKENS=0

# Prompt budgets in rough tokens (1 token ~ 3 characters).
RECENT_CONTEXT_TOKENS=5000
FOCUS_HISTORY_TOKENS=1500
AUTHOR_HISTORY_TOKENS=600
SUMMARY_CHUNK_TOKENS=2500
SUMMARY_MAX_WORDS=900

REACTIONS_ENABLED=true
# Weekly digest: DIGEST_WEEKDAY 0=Mon ... 6=Sun, DIGEST_TIME in TIMEZONE.
WEEKLY_DIGEST=true
DIGEST_WEEKDAY=6
DIGEST_TIME=20:00
DIGEST_MIN_MESSAGES=20

LOG_LEVEL=INFO

# Optional services (docker-compose profiles): discord — needs .env.discord, web — the settings panel.
# COMPOSE_PROFILES=discord,web
