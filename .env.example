# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# GonkaGate API key (used against an OpenAI-compatible /v1/chat/completions endpoint)
GONKAGATE_API_KEY=
GONKAGATE_BASE_URL=https://api.gonkagate.com/v1
MODEL_NAME=deepseek-ai/deepseek-v4-flash-0731

# The persona/behavior prompt, e.g. "Hate this participant" or "Say how great this participant is".
# This is sent to the model as its system instruction on every message.
BOT_PROMPT=Комментируй сообщения участников с максимальным сарказмом.

# --- Trigger tuning ---
# How many recent messages to feed as context to the model for each decision
CONTEXT_WINDOW=15
# Safety cooldown: minimum seconds between two comments in the same chat,
# even if the model decides "yes" more often than that
MIN_SECONDS_BETWEEN_COMMENTS=20
# Max tokens for the model's response (decision JSON + comment)
MAX_TOKENS=200
REQUEST_TIMEOUT_SECONDS=30
