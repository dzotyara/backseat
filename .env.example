# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# GonkaGate API key (used against an OpenAI-compatible /v1/chat/completions endpoint)
GONKAGATE_API_KEY=
GONKAGATE_BASE_URL=https://api.gonkagate.com/v1
MODEL_NAME=deepseek-ai/deepseek-v4-flash-0731

# The persona/behavior prompt, e.g. "Hate this participant" or "Say how great this participant is".
# This is sent to the model as its system instruction whenever it's asked to decide.
BOT_PROMPT=Комментируй сообщения участников с максимальным сарказмом.

# --- Trigger tuning ---
# The bot does NOT check on every message. It checks (asks the LLM whether to
# comment) once every N messages, where N is randomly re-picked each time
# between MIN and MAX — plus always on a mention/reply, and whenever the last
# message looks like a question.
MIN_MESSAGES_BETWEEN_COMMENTS=2
MAX_MESSAGES_BETWEEN_COMMENTS=15
# How many recent messages to keep in the raw per-chat history buffer
CONTEXT_WINDOW=15
# Extra cap on the context sent to the model, in a rough token estimate
# (oldest messages are dropped first if the buffer exceeds this budget)
MAX_INPUT_TOKENS=1500
# Safety cooldown: minimum seconds between two comments in the same chat,
# even if triggered again right away (mentions/replies bypass this)
MIN_SECONDS_BETWEEN_COMMENTS=10

# --- Model call tuning ---
# Max tokens for the model's response (decision JSON + comment)
MAX_TOKENS=200
REQUEST_TIMEOUT_SECONDS=30
# GonkaGate enforces a *concurrent requests* limit (separate from any per-minute
# rate limit) — e.g. "rate limit exceeded: too many concurrent requests".
# Keep this at or below whatever your plan allows; extra requests just queue.
GONKAGATE_MAX_CONCURRENCY=1
