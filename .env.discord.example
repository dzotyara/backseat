# Discord bot settings. docker-compose loads the shared .env first and this file on top of it, so
# everything set here wins, and an empty value means the built-in default — not the .env value.
# The OpenRouter key, models and prompt budgets come from the shared .env.

# Developer Portal -> your application -> Bot: Reset Token, and switch on "Message Content Intent".
# Invite with the scopes bot + applications.commands and the permissions View Channels, Send Messages,
# Send Messages in Threads, Read Message History, Add Reactions.
DISCORD_BOT_TOKEN=

# Channels the bot lives in (Developer Mode on -> right-click a channel -> Copy Channel ID).
# Threads inside them count too. Empty = every channel the bot can see.
ALLOWED_CHAT_IDS=123456789012345678
# Extra Discord user ids for /prompt, /status and changing /names. The application owner
# (or its whole team) always is one; keep it empty so Telegram owner ids don't leak in.
OWNER_IDS=
# Names the bot answers to without @.
BOT_NAMES=ботяра,botyara
# Participants with a fixed display name and a longer personal history: discord_id:name
FOCUS_USERS=

PERSONA_FILE=prompts/discord.md
DB_PATH=data/discord.db

# On the first start, read this many days of each allowed channel's history and fold it into the
# memory (0 = off). A busy channel's three months are tens of thousands of messages: about a dollar.
BACKFILL_DAYS=90
# A busy channel: a cheap yes/no look at the last ~30 messages before the full, memory-laden decision
# whether to chime in. Without it, ~600 messages a day cost ~$0.25 a day; with it ~$0.08-0.10.
PRECHECK_CONTEXT_TOKENS=600
# How often anyone may ask for /digest in one channel.
DIGEST_COOLDOWN_SECONDS=600
